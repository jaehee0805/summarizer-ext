{
  "manifest_version": 3,
  "name": "Gemini Summarizer",
  "version": "1.1",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://my-gemini-proxy-one.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}